SEARCH_BACKEND=elasticsearch

# Federated `odis` index on the Gleaner ES cluster
GLEANER_ELASTICSEARCH_URL=http://odis.org:9400
# GLEANER_ELASTICSEARCH_USER=
# GLEANER_ELASTICSEARCH_PASSWORD=
GLEANER_INDICES=odis

VITE_API_URL=/api/v1

# Production TLS (host Certbot — see README)
DOMAIN=search.example.org
LETSENCRYPT_EMAIL=you@example.org
# Set to 1 while testing against Let's Encrypt staging CA:
# CERTBOT_STAGING=1
